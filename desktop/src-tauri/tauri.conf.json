{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Topo",
  "version": "0.0.0",
  "identifier": "systems.carino.topo",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/topo-desktop-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Carino Systems",
    "homepage": "https://topo.carino.systems/",
    "license": "AGPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "Network documentation editor that works offline",
    "longDescription": "Topo documents a site's network: devices, cables, subnets, Wi-Fi, racks and providers, with checks, reports and spreadsheets. Everything stays on this computer.",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../fonts/OFL.txt": "licenses/OFL.txt",
      "../../vendor/LICENSE.ipaddr.js": "licenses/LICENSE.ipaddr.js",
      "../../vendor/LICENSE.qrcode-generator": "licenses/LICENSE.qrcode-generator"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh",
        "languages": [
          "English",
          "Spanish",
          "PortugueseBR",
          "Japanese",
          "Russian"
        ]
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/systemd/system/topo-desktop-server.service": "linux/topo-desktop-server.service",
          "/usr/lib/sysusers.d/topo-desktop-server.conf": "linux/topo-desktop-server.sysusers",
          "/usr/share/polkit-1/actions/systems.carino.topo.policy": "linux/systems.carino.topo.policy"
        },
        "postInstallScript": "linux/postinst.sh",
        "preRemoveScript": "linux/prerm.sh",
        "postRemoveScript": "linux/postrm.sh"
      },
      "rpm": {
        "files": {
          "/usr/lib/systemd/system/topo-desktop-server.service": "linux/topo-desktop-server.service",
          "/usr/lib/sysusers.d/topo-desktop-server.conf": "linux/topo-desktop-server.sysusers",
          "/usr/share/polkit-1/actions/systems.carino.topo.policy": "linux/systems.carino.topo.policy"
        },
        "postInstallScript": "linux/postinst.sh",
        "preRemoveScript": "linux/prerm.sh",
        "postRemoveScript": "linux/postrm.sh"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.3"
    }
  }
}
