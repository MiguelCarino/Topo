#!/bin/sh
# topo-monitor postrm. The files in /var/lib/topo-monitor are never deleted,
# not even on purge: they hold this monitor's key and its statistics.
# `topo-monitor forget` (before removing) forgets the key.
set -e
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi
exit 0
