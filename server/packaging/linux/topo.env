# Topo server settings (/etc/topo/topo.env), read by topo-server.service.
# KEY=VALUE, one per line; docs/SERVER.md (/usr/share/doc/topo-server/SERVER.md)
# lists every key. After a change: sudo systemctl restart topo-server
#
# As shipped every line is a comment: the server answers only on this
# machine at http://127.0.0.1:7380 and writes sign-in codes to the journal
# (journalctl -u topo-server). The data lives in /var/lib/topo.

# The address people open. Behind a reverse proxy with https on this machine:
#TOPO_PUBLIC_URL=https://topo.example.com
#TOPO_TRUSTED_PROXIES=127.0.0.1/32
# Or https built in, with your own certificate (readable by the topo user) ...
#TOPO_LISTEN=0.0.0.0:7380
#TOPO_TLS_CERT=/etc/topo/tls/cert.pem
#TOPO_TLS_KEY=/etc/topo/tls/key.pem
# ... or a self-signed one the server makes in /var/lib/topo/tls:
#TOPO_TLS_SELF=1

# The server owner and email (sign-in codes are sent by email).
#TOPO_OWNER_EMAIL=it@example.com
#TOPO_SMTP_HOST=smtp.office365.com
#TOPO_SMTP_PORT=587
#TOPO_SMTP_USER=topo@example.com
#TOPO_SMTP_PASS_FILE=/etc/topo/smtp.pass
#TOPO_SMTP_FROM=Topo <topo@example.com>

# Folders a "folder on the server" backup may use (: between folders). The
# default is /var/lib/topo/backups. Another folder must exist, belong to the
# topo user (sudo chown topo:topo /mnt/backup/topo) and be made writable for
# the service with a drop-in (see backup-folder.conf.example in
# /usr/share/doc/topo-server).
#TOPO_BACKUP_FOLDERS=/var/lib/topo/backups:/mnt/backup/topo
