          ]
        },
        "rev": {
          "type": "string"
        },
        "incidentId": {
          "type": "string"
        },
        "event": {
          "type": "string"
        },
        "symptom": {
          "type": "string"
        },
        "routedTo": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "providerId": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "arrived": {
          "type": "number"
        },
        "left": {
          "type": "number"
        },
        "outcome": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
