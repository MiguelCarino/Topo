{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topo.carino.systems/schema/topo-v18.json",
  "title": "Topo network file",
  "description": "DRAFT. Describes the envelope of a file Topo writes (one network's back-up, or a binder of several networks) and the top-level keys of a Topo document (document version 18) only, with loose types. The full field-level specification is step 6 of docs/SCOPE.md in the Topo repository. Files are saved as application/vnd.carino.topo+json with a .json extension. Readers ignore \"$schema\"; nothing fetches this address.",
  "anyOf": [
    {
      "$ref": "#/$defs/networkFile"
    },
    {
      "$ref": "#/$defs/binderFile"
    },
    {
      "$ref": "#/$defs/document"
    }
  ],
  "$defs": {
    "networkFile": {
      "description": "One network's back-up: the envelope Topo's \"Back up\" (.json) writes.",
      "type": "object",
      "required": [
        "kind",
        "doc"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "kind": {
          "const": "nettopology"
        },
        "version": {
          "type": "integer",
          "description": "The envelope's own format version (1). The document's version is doc.v."
        },
        "name": {
          "type": "string",
          "description": "The network's card name."
        },
        "doc": {
          "$ref": "#/$defs/document"
        }
      },
      "additionalProperties": true
    },
    "binderFile": {
      "description": "A binder: several networks (and templates or blocks) in one file.",
      "type": "object",
      "required": [
        "kind",
        "sites"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "kind": {
          "const": "nettopo-binder"
        },
        "version": {
          "type": "integer"
        },
        "exported": {
          "type": [
            "string",
            "number"
          ],
          "description": "When the file was written: an ISO date-time, or milliseconds since 1970."
        },
        "sites": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "doc"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "created": {
                "type": "number"
              },
              "updated": {
                "type": "number"
              },
              "template": {
                "type": "boolean"
              },
              "block": {
                "type": "boolean"
              },
              "rev": {
                "type": "string",
                "description": "The site's revision as it left (v17)."
              },
              "base": {
                "type": "string",
                "description": "The revision it was started from (v17)."
              },
              "prior": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Earlier revisions it carried, newest first (v17)."
              },
              "doc": {
                "$ref": "#/$defs/document"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "document": {
      "description": "A Topo document. Only nodes is required; a missing list is an empty one. Older documents (a lower v, or none) are migrated when they are opened.",
      "type": "object",
      "required": [
        "nodes"
      ],
      "properties": {
        "v": {
          "type": [
            "integer",
            "string"
          ],
          "description": "Document version (18 here)."
        },
        "id": {
          "type": "string"
        },
        "updated": {
          "type": "number"
        },
        "rev": {
          "type": "string",
          "description": "Revision token of this copy as it left (v17): a new one whenever the content changed since the last copy that left. Identity, like id and updated: not part of the content."
        },
        "base": {
          "type": "string",
          "description": "Revision this copy was started from (v17): the base of a three-way merge when it comes back."
        },
        "prior": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Earlier revisions this document carried, newest first, at most 8 (v17)."
        },
        "nodes": {
          "type": "array",
          "description": "Devices. Each may name the providers responsible for it (providers: a list of provider ids, v18; v15-v17 wrote one id as provider)."
        },
        "links": {
          "type": "array",
          "description": "Cables. Each may name its providers (providers: a list of provider ids, v18)."
        },
        "networks": {
          "type": "array",
          "description": "Subnets."
        },
        "groups": {
          "type": "array",
          "description": "Groups (buildings, floors, rooms, racks). Each may name its providers (providers: a list of provider ids, v18), which answer for every device inside for the services the device names nobody for."
        },
        "wifi": {
          "type": "array",
          "description": "Wi-Fi networks."
        },
        "providers": {
          "type": "array",
          "description": "Who is responsible for what: a name, a service, contact details, support hours, notes."
        },
        "accepted": {
          "type": "array",
          "description": "Findings accepted with a reason."
        },
        "pinned": {
          "type": "array",
          "description": "Pinned findings."
        },
        "expectedLife": {
          "type": "object",
          "description": "Expected life in years, by device type."
        },
        "annotations": {
          "type": "array",
          "description": "Text notes on the map."
        },
        "report": {
          "type": "object",
          "description": "The report header (site, client, engineer, ref, date, scope)."
        },
        "columns": {
          "type": "array",
          "description": "Custom columns."
        },
        "tableView": {
          "type": "object",
          "description": "The Devices table's arrangement."
        },
        "searches": {
          "type": "array",
          "description": "Saved searches."
        },
        "incidents": {
          "type": "array",
          "description": "Problem reports (v18), oldest first, at most 200: a client says what is wrong and where, Topo routes it to the providers responsible, and their visits come back as 'visit' log entries.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "at",
              "status",
              "symptom"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "'in' and 10 base-36 characters; the same id is the same report wherever it travelled."
              },
              "at": {
                "type": "number",
                "description": "When it was reported, milliseconds since 1970."
              },
              "status": {
                "type": "string",
                "description": "'open', 'sent', 'visited' or 'closed'; it only moves forward."
              },
              "reopened": {
                "type": "integer",
                "description": "How many times it was reopened."
              },
              "symptom": {
                "type": "string",
                "description": "'internet', 'wifi', 'phone', 'camera', 'printer', 'power' or 'other'."
              },
              "nodeIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The devices with the problem."
              },
              "groupId": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "description": "The client's words, at most 2000 characters."
              },
              "reporter": {
                "type": "object",
                "description": "name, phone, email."
              },
              "routedTo": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Provider ids it was sent to."
              },
              "sentAt": {
                "type": "number"
              },
              "visits": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Ids of its 'visit' log entries."
              },
              "closedAt": {
                "type": "number"
              },
              "closedNote": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "log": {
          "type": "array",
          "description": "The network log (v17; v18 adds the kinds 'incident' and 'visit'): an append-only list of what was done to the network from outside, oldest first, at most 500 (a link carries the newest 50). Unknown kinds are dropped by this version.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "at",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "at": {
                "type": "number",
                "description": "Milliseconds since 1970."
              },
              "kind": {
                "type": "string",
                "description": "'merge', 'incident' (a problem report opened, sent, closed or reopened) or 'visit' (a provider's visit)."
              },
              "source": {
                "type": "string",
                "description": "Where it came from: a file's name, 'link', 'binder' or a network's name."
              },
              "by": {
                "type": "string",
                "description": "merge: the prepared-by name in Settings, when one was set; visit: the technician."
              },
              "counts": {
                "type": "object",
                "properties": {
                  "added": {
                    "type": "integer"
                  },
                  "changed": {
                    "type": "integer"
                  },
                  "removed": {
                    "type": "integer"
                  },
                  "conflicts": {
                    "type": "integer"
                  }
                }
              },
              "summary": {
                "type": "string",
                "description": "English text, at most 160 characters."
              },
              "mode": {
                "type": "string",
                "description": "'two-way' or 'three-way'."
              },
              "rev": {
                "type": "string",
                "description": "The revision merged in."
              },
              "incidentId": {
                "type": "string",
                "description": "incident, visit: the problem report's id."
              },
              "event": {
                "type": "string",
                "description": "incident: 'opened', 'sent', 'closed' or 'reopened'."
              },
              "symptom": {
                "type": "string",
                "description": "incident: the symptom."
              },
              "routedTo": {
                "type": "array",
                "description": "incident: provider ids it was sent to."
              },
              "providerId": {
                "type": "string",
                "description": "visit: the provider who visited."
              },
              "provider": {
                "type": "string",
                "description": "visit: that provider's name as it was then."
              },
              "arrived": {
                "type": "number",
                "description": "visit: milliseconds since 1970."
              },
              "left": {
                "type": "number",
                "description": "visit: milliseconds since 1970."
              },
              "outcome": {
                "type": "string",
                "description": "visit: 'fixed', 'partly', 'not-fixed' or 'follow-up'."
              },
              "notes": {
                "type": "string",
                "description": "visit: at most 4000 characters."
              },
              "changes": {
                "type": "object",
                "description": "visit: counts { added, changed, removed } and up to 200 items { kind, id, name, status } changed since the copy the provider received."
              },
              "signoff": {
                "type": "string",
                "description": "visit: the client's name, typed on the provider's device."
              },
              "prev": {
                "type": "string",
                "description": "SHA-256 (64 hex characters) of the entry before it in this document."
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}
