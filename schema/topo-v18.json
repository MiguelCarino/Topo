        },
        "providers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Provider ids (doc.providers), v18."
        }
      },
      "additionalProperties": false,
      "description": "A building, floor, room, rack or other group (GROUP_FIELDS)."
    },
    "wifi": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
