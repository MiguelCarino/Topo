        },
        "contact": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "account": {
          "type": "string"
        },
        "hours": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Who is responsible for something (PROVIDER_FIELDS), at most 100."
