        "nodeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "linkIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        },
        "until": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false,
